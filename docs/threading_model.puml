@startuml RTES_Threading_Model

title RTES Threading Model & Deployment

node "Trading Exchange Process" {
    
    component "Main Thread" {
        [Initialization]
        [Configuration]
        [Shutdown Manager]
    }
    
    component "TCP Gateway Threads" {
        [Acceptor Thread] as T1
        [Worker Thread\n(epoll I/O)] as T2
    }
    
    component "Risk Thread" {
        [Risk Manager\nSingle-threaded] as T3
    }
    
    component "Matching Threads" {
        [AAPL Thread] as T4
        [MSFT Thread] as T5
        [GOOGL Thread] as T6
        note right of T4
          One thread per symbol
          Single-writer design
          No lock contention
        end note
    }
    
    component "Market Data Thread" {
        [UDP Publisher] as T7
    }
    
    component "Observability Threads" {
        [Metrics Server\n(HTTP)] as T8
        [Logger Thread] as T9
    }
    
    database "Shared Memory" {
        [Order Pool\n(1M orders)]
        [SPSC Queues]
        [MPMC Queue]
    }
}

' Thread Communication
T1 -down-> T2 : "New connections"
T2 -down-> [SPSC Queues] : "Lock-free push"
[SPSC Queues] -down-> T3 : "Lock-free pop"
T3 -down-> [SPSC Queues] : "Lock-free push"
[SPSC Queues] -down-> T4 : "Lock-free pop"
[SPSC Queues] -down-> T5 : "Lock-free pop"
[SPSC Queues] -down-> T6 : "Lock-free pop"
T4 -down-> [MPMC Queue] : "Lock-free push"
T5 -down-> [MPMC Queue] : "Lock-free push"
T6 -down-> [MPMC Queue] : "Lock-free push"
[MPMC Queue] -down-> T7 : "Lock-free pop"

T2 -right-> [Order Pool] : "allocate()"
T4 -right-> [Order Pool] : "deallocate()"
T5 -right-> [Order Pool] : "deallocate()"
T6 -right-> [Order Pool] : "deallocate()"

T2 -down-> T8 : "record metrics"
T3 -down-> T8 : "record metrics"
T4 -down-> T8 : "record metrics"

cloud "External" {
    [Trading Clients] as Clients
    [Market Data\nSubscribers] as Subscribers
    [Prometheus] as Prom
}

Clients <--> T2 : "TCP 8888"
T7 --> Subscribers : "UDP Multicast\n239.0.0.1:9999"
Prom <-- T8 : "HTTP 8080"

note bottom of "Trading Exchange Process"
  **Performance Characteristics**
  • Throughput: 150K orders/sec
  • Avg Latency: 8μs
  • P99 Latency: 85μs
  • Memory: 1.5GB stable
  • CPU: 65% @ 100K ops/s
end note

@enduml
