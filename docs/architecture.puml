@startuml RTES_Architecture

!define COMPONENT_BG #E3F2FD
!define QUEUE_BG #FFF9C4
!define DATA_BG #F3E5F5

' Title
title Real-Time Trading Exchange Simulator - Architecture

' Components
package "Client Layer" {
    [Trading Client] as Client
}

package "Network Layer" {
    component "TCP Gateway\n(Port 8888)" as Gateway COMPONENT_BG {
        [Acceptor Thread]
        [Worker Thread\n(epoll)]
        [ClientConnection]
    }
    
    component "UDP Publisher\n(239.0.0.1:9999)" as UDP COMPONENT_BG {
        [Market Data Thread]
        [HMAC Auth]
    }
}

package "Core Engine" {
    component "Risk Manager" as Risk COMPONENT_BG {
        [Risk Thread]
        [Client State]
        [Validation Rules]
    }
    
    component "Matching Engine\n(Per Symbol)" as Matching COMPONENT_BG {
        [AAPL Thread]
        [MSFT Thread]
        [GOOGL Thread]
    }
    
    component "Order Book" as OrderBook COMPONENT_BG {
        [Bids (map)]
        [Asks (map)]
        [Order Lookup]
        [Price-Time Priority]
    }
}

package "Memory Management" {
    database "Order Pool\n(1M pre-allocated)" as Pool DATA_BG
    database "Memory Pools" as MemPool DATA_BG
}

package "Lock-Free Queues" {
    queue "SPSC Queue\nGateway→Risk" as Q1 QUEUE_BG
    queue "SPSC Queue\nRisk→Matching" as Q2 QUEUE_BG
    queue "MPMC Queue\nMatching→UDP" as Q3 QUEUE_BG
}

package "Observability" {
    [Metrics Server\n(Port 8080)] as Metrics
    [Logger]
    [Performance Tracker]
}

' Relationships
Client -down-> Gateway : "TCP\nNewOrder/Cancel"
Gateway -down-> Q1 : "push(Order)"
Q1 -down-> Risk : "pop(Order)"
Risk -down-> Q2 : "push(Validated)"
Q2 -down-> Matching : "pop(Order)"
Matching -down-> OrderBook : "add_order()"
OrderBook -up-> Matching : "on_trade()"
Matching -right-> Q3 : "push(Trade/BBO)"
Q3 -up-> UDP : "pop(Event)"
UDP -up-> Client : "UDP Multicast\nTrades/BBO"

Gateway -down-> Pool : "allocate()"
Risk -down-> Pool : "validate"
OrderBook -down-> Pool : "deallocate()"

Gateway -down-> Metrics : "record"
Risk -down-> Metrics : "record"
Matching -down-> Metrics : "record"

note right of Gateway
  **TCP Gateway**
  • Non-blocking I/O (epoll)
  • TCP_NODELAY enabled
  • Binary protocol parsing
  • CRC32 validation
  • ~2μs latency
end note

note right of Risk
  **Risk Manager**
  • Single-threaded
  • Size/Price/Credit checks
  • Rate limiting
  • Duplicate detection
  • ~1μs latency
end note

note right of OrderBook
  **Order Book**
  • Price-time priority
  • Cache prefetching
  • Zero allocations
  • Mutex per symbol
  • ~4μs latency
end note

note right of Q1
  **Lock-Free Queues**
  • SPSC: Single Producer
    Single Consumer
  • MPMC: Multi Producer
    Multi Consumer
  • Atomic operations
  • Cache-line aligned
end note

@enduml
